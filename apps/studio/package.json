{
  "name": "@wondershine/studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env server/dev.ts",
    "build": "tsc --noEmit && vite build && tsx scripts/build-server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "node --env-file-if-exists=.env dist/server.mjs",
    "password": "tsx scripts/password.ts",
    "test:browser": "tsx tests/browser/smoke.mjs && node tests/browser/react-lifecycle.mjs",
    "test:loading": "tsx tests/browser/loading-runner.mjs",
    "doctor": "tsx --env-file-if-exists=.env scripts/doctor.ts",
    "test:site": "tsx --test --test-concurrency=1 tests/templates/*.test.*",
    "setup": "tsx scripts/setup.ts",
    "dev:app": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build:app": "tsc --noEmit && vite build && tsx scripts/copy-app-assets.ts",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "app:android": "tauri android dev",
    "app:ios": "tauri ios dev",
    "test:native-browser": "node tests/browser/native.mjs",
    "test:react-browser": "node tests/browser/react-lifecycle.mjs",
    "test:native-macos": "node tests/native/macos.mjs"
  },
  "dependencies": {
    "@edgeone/pages-blob": "0.0.18",
    "@hono/node-server": "2.1.5",
    "@preact/signals-react": "^3.12.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "buffer": "^6.0.3",
    "dompurify": "3.4.17",
    "hono": "4.13.13",
    "isomorphic-git": "1.44.4",
    "marked": "18.1.1",
    "openid-client": "6.8.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "saxes": "6.0.0",
    "smol-toml": "1.9.1",
    "toml-eslint-parser": "1.0.3",
    "vditor": "4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "0.28.2",
    "puppeteer-core": "25.16.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "license": "AGPL-3.0-or-later"
}
