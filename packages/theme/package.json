{
  "name": "@wondershine/theme",
  "version": "0.2.1",
  "description": "WonderShine: an Astro theme for articles, threads and multilingual publishing",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "Jiaxiang Wang",
  "repository": {
    "type": "git",
    "url": "https://github.com/iWangJiaxiang/Astro-Theme-WonderShine.git",
    "directory": "packages/theme"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "exports": {
    ".": "./integration.mjs",
    "./content": "./src/lib/content.ts",
    "./components/*": "./src/components/*",
    "./layouts/*": "./src/layouts/*",
    "./styles/*": "./src/styles/*",
    "./package.json": "./package.json"
  },
  "files": [
    "integration.mjs",
    "dist",
    "src",
    "styles",
    "assets",
    "defaults",
    "locales",
    "LICENSE",
    "README.md",
    "NOTICE.md"
  ],
  "peerDependencies": {
    "astro": "7.4.4"
  },
  "dependencies": {
    "any-ascii": "^0.3.3",
    "markdown-it": "^14.1.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "sharp": "^0.35.5",
    "smol-toml": "^1.4.2",
    "unicode-default-word-boundary": "16.0.0",
    "prismjs": "^1.30.0"
  },
  "scripts": {
    "prepack": "node ../../scripts/build-theme.mjs"
  }
}
