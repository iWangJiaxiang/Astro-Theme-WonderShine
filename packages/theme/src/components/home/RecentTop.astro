---
import ResponsiveImage from '../ResponsiveImage.astro';
import {articles,cover} from '../../lib/queries';
import {localizeConfig,localizeData,localizeUrl,t} from '../../lib/locale';
import {routes} from '../../lib/routes';
import type {Document,Site} from '../../lib/types';
import {featuredDocument} from './data';

interface Props {site:Site;lang:string;}
const {site,lang}=Astro.props;
const config=localizeConfig(site,lang),data=localizeData(site,lang),top=config.extra.top;
const url=(path:string)=>localizeUrl(path,lang,site),tr=(key:string)=>t(key,lang,site);
const left=top.banner_left,settings=top.banner_right.recommend_post;
const skills=data.skill?.items||[];
const pairs=Array.from({length:Math.ceil(skills.length/2)},(_,index)=>skills.slice(index*2,index*2+2));
const configured=left.category_groups||[];
const paths=new Set(routes(site).filter(route=>route.lang===lang).map(route=>route.path));
const groups=configured.filter((group:any)=>!/^\/(tags|categories)\//.test(group.url)||paths.has(url(group.url).split(/[?#]/)[0].replace(/\/?$/,'/')));
if(configured.length&&!groups.length){
  for(const group of [
    {title:tr('archive_title'),url:'/archives/',icon:'icon-book'},
    {title:tr('about'),url:'/about/',icon:'icon-user'},
  ]) if(paths.has(url(group.url))) groups.push(group);
}
const sources:string[]=data.post?.recommend_posts||[];
const selected:Document[]=settings.type==='latest'||!sources.length ? articles(site,lang)
  : sources.map(source=>featuredDocument(site,source,lang)).filter((post):post is Document=>!!post);
const today=data.post?.today_recommend||{};
const featured=today.post_path ? featuredDocument(site,today.post_path,lang) : !today.url ? selected[0] : undefined;
const daily=top.banner_right.today_recommend.enable ? (featured
  ? {url:featured.url,title:featured.title,cover:cover(featured,site)}
  : !today.post_path && today.url ? {...today,url:url(today.url)} : undefined) : undefined;
const aboveFold=!(top.above?.enable_above??top.above?.enable);
const posts=selected.filter(post=>post.url!==daily?.url).slice(0,Math.min(6,settings.max_posts||6));
const colorStyle=(group:any)=>({'--group-light-one':group.colors?.light_one,'--group-light-two':group.colors?.light_two,'--group-dark-one':group.colors?.dark_one,'--group-dark-two':group.colors?.dark_two});
---
<div id="recent-top-post-group"><div id="recent-post-top">
  <div id="bannerGroup">
    <div id="banners">
      {pairs.length>0&&<div class="tags-group-all" aria-hidden="true"><div class="tags-group-wrapper">{pairs.map(pair=><div class="tags-group-icon-pair">{pair.map((tech:any)=><div class="tags-group-icon" style={{background:tech.bg_color}}>{tech.logo?<img src={tech.logo} alt="" loading="lazy" decoding="async"/>:tech.icon?<i class={tech.icon}/>:tech.svg_symbol_id&&<svg><use href={`${tech.svg_sprite||data.skill.svg_sprite}#${tech.svg_symbol_id}`}/></svg>}</div>)}</div>)}</div></div>}
      {!skills.length&&config.extra.site.logo&&<img class="banner-logo" src={config.extra.site.logo} alt="" decoding="async"/>}
      <div class="banners-title">
        {left.title_big&&<div role="heading" aria-level={(top.above?.enable_above??top.above?.enable)?2:1} set:html={left.title_big}/>}
        {left.title_small&&<div class="banners-title-small" set:html={left.title_small}/>}
      </div>
    </div>
    {!!groups.length&&<div class="banners-link">{groups.slice(0,2).map((group:any,index:number)=><a class:list={['banners-link-btn',{'blb-top':index===1}]} href={url(group.url)} style={colorStyle(group)}>
      {/^https?:|^\//.test(group.icon)?<img src={group.icon} alt="" loading="lazy"/>:<i class={group.icon} aria-hidden="true"/>}
      <span class="banners-link-title">{group.title}</span>
    </a>)}</div>}
  </div>
  {(daily||posts.length>0)&&<div id="topGroup" class:list={{'has-recommendations':posts.length>0}}>
    {daily&&<a class="todayCard" id="todayCard" href={daily.url}>
      {daily.cover&&<ResponsiveImage site={site} class="todayCard-cover" src={daily.cover} alt="" width={700}
        preloadMedia={aboveFold ? posts.length ? '(min-width: 1200px)' : 'all' : undefined}
        sizes="(min-width: 1400px) 680px, (min-width: 1200px) 50vw, 200px"/>}
      <div class="todayCard-info"><div class="todayCard-tips">{today.small_title||t('featured',lang,site,'activity')}</div><div class="todayCard-title">{daily.title}</div></div>
    </a>}
    {daily&&posts.length>0&&<button id="recommendations-toggle" type="button" aria-controls="home-recommendations" aria-expanded="false">
      <i class="icon-circle-plus" aria-hidden="true"/><span class="show-recommendations">{tr('ui_more_recommendations')}</span>
      <i class="icon-circle-xmark" aria-hidden="true"/><span class="hide-recommendations">{tr('ui_collapse_recommendations')}</span>
    </button>}
    {posts.length>0&&<ul id="home-recommendations">
      {posts.map((post,index)=>{
        const thumbnail=cover(post,site);
        return <li><a class="recommendation-link" href={post.url}>
          {thumbnail ? <ResponsiveImage site={site} class="recommendation-cover" src={thumbnail} alt="" width={240}
            preloadMedia={aboveFold && index===0 ? daily ? '(width < 1200px)' : 'all' : undefined}
            sizes="(min-width: 1400px) 224px, 200px"/> : <span class="recommendation-cover" aria-hidden="true"/>}
          <span class="recommendation-title">{post.title}</span>
        </a></li>;
      })}
    </ul>}
  </div>}
</div></div>
<script>
  function bindRecommendations() {
    const toggle=document.querySelector<HTMLButtonElement>('#recommendations-toggle');
    const group=toggle?.parentElement;
    if(!toggle||!group||group.dataset.recommendationsReady)return;
    group.dataset.recommendationsReady='true';
    const expanded=()=>toggle.getAttribute('aria-expanded')==='true';
    const setExpanded=(open:boolean)=>toggle.setAttribute('aria-expanded',String(open));
    toggle.addEventListener('click',()=>setExpanded(!expanded()));
    group.addEventListener('pointerleave',event=>{
      if(event.pointerType==='mouse'&&!group.querySelector(':focus-visible'))setExpanded(false);
    });
    group.addEventListener('keydown',event=>{
      if(event.key!=='Escape'||!expanded()||!toggle.offsetWidth)return;
      setExpanded(false);
      toggle.focus();
    });
  }
  bindRecommendations();
  document.addEventListener('astro:page-load',bindRecommendations);
</script>
