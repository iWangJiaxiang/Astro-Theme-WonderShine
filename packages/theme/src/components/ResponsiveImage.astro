---
import type { HTMLAttributes } from 'astro/types';
import type { Site } from '../lib/types';
import { responsiveImage, responsiveSizes } from '../lib/image-assets';
interface Props extends HTMLAttributes<'img'> {
  site: Site;
  src: string;
  alt: string;
  preloadMedia?: string;
  pictureClass?: string;
  pictureStyle?: HTMLAttributes<'picture'>['style'];
}
const { site, src, alt, width, height, preloadMedia, pictureClass = 'responsive-image', pictureStyle = 'display:contents', sizes = '(max-width: 768px) 100vw, 800px', loading = 'lazy', decoding = 'async', ...attributes } = Astro.props;
const image = responsiveImage(site, src, Number(width) || 800);
const sourceSizes = responsiveSizes(sizes || '(max-width: 768px) 100vw, 800px', loading === 'lazy' && !preloadMedia ? 'lazy' : 'eager');
const preloadSrcset = image.avifSrcset || image.webpSrcset;
const intrinsicWidth = width || image.width;
const intrinsicHeight = height || (width && image.width && image.height ? Math.round(Number(width) * image.height / image.width) : image.height);
---
{preloadMedia && src && <link rel="preload" as="image" media={preloadMedia} fetchpriority="high"
  type={image.avifSrcset ? 'image/avif' : image.webpSrcset ? 'image/webp' : undefined}
  href={preloadSrcset ? undefined : image.src}
  imagesrcset={preloadSrcset} imagesizes={preloadSrcset ? sourceSizes : undefined} />}
<picture class={pictureClass} style={pictureStyle} data-original={src}>
  {image.avifSrcset && <source type="image/avif" srcset={image.avifSrcset} sizes={sourceSizes} />}
  {image.webpSrcset && <source type="image/webp" srcset={image.webpSrcset} sizes={sourceSizes} />}
  <img {...attributes} src={image.src} alt={alt} width={intrinsicWidth} height={intrinsicHeight} srcset={image.webpSrcset} sizes={image.webpSrcset ? sourceSizes : undefined} loading={loading} decoding={decoding} data-original={src} />
</picture>
