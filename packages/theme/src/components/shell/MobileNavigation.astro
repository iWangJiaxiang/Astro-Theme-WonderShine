---
import {t,localizeConfig,localizeUrl} from '../../lib/locale';
import {siteNavigation} from '../../lib/site-navigation';
import MenuTree from './MenuTree.astro';
const {site,lang}=Astro.props,config=localizeConfig(site,lang);
const menus=siteNavigation(site,lang);
const tr=(key:string)=>t(key,lang,site),zh=lang.startsWith('zh');
const icons=['M6 3h9l3 3v15H6z M14 3v5h4 M9 12h6 M9 16h6','m3 8 9-5 9 5-9 5z M3 12l9 5 9-5 M3 16l9 5 9-5','M3 4c4-1 6 0 9 2 3-2 5-3 9-2v15c-4-1-6 0-9 2-3-2-5-3-9-2z M12 6v15','M3 4h18v16H3z m1 12 6-6 5 5 3-3 3 3 M16 8h.01','M10 14l4-4 M8 16l-2 2a4 4 0 0 1-6-6l5-5a4 4 0 0 1 6 0 M13 17a4 4 0 0 0 6 0l5-5a4 4 0 0 0-6-6l-2 2','M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0 M4 21v-2a8 8 0 0 1 16 0v2z'];
---
<dialog id="sidebar-menus" data-responsive-drawer aria-labelledby="mobile-navigation-title" data-default-theme={config.extra.style.color_scheme}>
  <header class="drawer-heading"><strong id="mobile-navigation-title">{tr('navigation')}</strong><button type="button" data-drawer-close aria-label={tr('close')}>×</button></header>
  <nav class="drawer-links" aria-label={tr('navigation')}>
    {menus.map((menu,index)=>menu.menus?.length ?
      <details class="drawer-group"><summary><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[index]||icons[0]}/></svg><span>{menu.name}</span><span class="drawer-chevron" aria-hidden="true">›</span></summary><div class="drawer-children">{menu.href&&<a href={localizeUrl(menu.href,lang,site)} target={menu.target} rel={menu.rel}>{menu.name} →</a>}<MenuTree menu={menu} site={site} lang={lang}/></div></details>
      : <a class="drawer-link" href={localizeUrl(menu.href||'#',lang,site)} target={menu.target} rel={menu.rel}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[index]||icons[0]}/></svg><span>{menu.name}</span><span class="drawer-chevron" aria-hidden="true">›</span></a>)}
  </nav>
  <section class="drawer-tools" aria-label={zh?'外观':'Appearance'}><p>{zh?'外观':'Appearance'}</p><div class="theme-options">{[['light',zh?'浅色':'Light'],['dark',zh?'深色':'Dark'],['system',zh?'跟随系统':'System']].map(([value,label])=><button type="button" data-theme-choice={value} aria-pressed="false">{label}</button>)}</div></section>
  {config.extra.nav.right?.article&&<button class="drawer-random" data-random-article><i class="icon-dice" aria-hidden="true"/>{tr('random_article')}<span aria-hidden="true">›</span></button>}
</dialog>
<script>import '../../scripts/responsive-navigation';</script>
