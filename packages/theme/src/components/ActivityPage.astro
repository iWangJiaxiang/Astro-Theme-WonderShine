---
import ResponsiveImage from './ResponsiveImage.astro';
import ThreadCard from './ThreadCard.astro';
import Sidebar from './Sidebar.astro';
import ActivitySidebar from './ActivitySidebar.astro';
import TimelineEvent from './TimelineEvent.astro';
import Comments from './Comments.astro';
import {utcDateTitle} from '../lib/date-display';
import type {Document} from '../lib/types';
import Pagination from './Pagination.astro';
import {siteFeedFilenames} from '../lib/feeds';
import {events,topics,topicItems,activeTimestamp,timestamp,formatDate,plain,cover} from '../lib/queries';
import {t,localizeConfig,localizeUrl,localeHome} from '../lib/locale';
const {site,route}=Astro.props;
const {lang,type,document}=route;
const config=localizeConfig(site,lang);
const tr=(key:string)=>t(key,lang,site,'activity');
const url=(p:string)=>localizeUrl(p,lang,site);
const isDetail=type==='thread',isTopic=type==='topic',isTopics=type==='topics',isThreads=type==='threads',isTimeline=type==='timeline';
const items=isTopic?topicItems(site,document):events(site,lang);
const lastActivity=(list:Document[])=>Math.max(0,...list.map(item=>activeTimestamp(item)));
const title=isTopic?`#${document.title}`:isDetail?(document.title||tr(type)):tr(type);
const introKey=`${type}_intro`;
const configuredIntro=config.extra.activity?.[introKey];
const intro=isTopic?document.description:typeof configuredIntro==='string'&&configuredIntro.trim()?configuredIntro:tr(introKey);
const topicActivity=isTopic?lastActivity(items):0;
const topicActivityDate=topicActivity?new Date(topicActivity*1000).toISOString():undefined;
---
<main class:list={['activity-layout', (isThreads||isDetail)&&['thread-layout',config.extra.sidebar.location]]} id="content-inner">
<div class="activity-main" data-activity-list={(!isThreads&&!isDetail)||undefined} data-page-size="12" data-sort={isTopics?'active':'published'} data-topic-id={isTopic?document.extra.id:undefined}>
{isDetail ? <>
  <header class="activity-heading"><h1>{title}</h1></header>
  <ThreadCard site={site} document={document} lang={lang} detail/>
  <Comments site={site} document={document} lang={lang}/>
</> : <>
{isTopic&&<div class="activity-detail-top"><a href={url('/topics/')}>← {tr('topics')}</a></div>}
<header class="activity-heading"><div>{isTopic&&<p class="activity-eyebrow">{tr('topic')}</p>}<h1>{title}</h1>{isTopic&&document.extra.ai_translation&&<span class="ai-translation-label">{tr('ai_translation')}</span>}{intro&&<p>{intro}</p>}</div></header>
{isThreads ? <><nav class="activity-toolbar"><a class="is-active" aria-current="page" href={url('/threads/')}>{tr('threads')}</a><a href={url('/topics/')}>{tr('topics')}</a><a href={url('/timeline/')}>{tr('timeline')}</a>{siteFeedFilenames(site,lang).includes('threads.xml')&&<a class="activity-feed" href={`${localeHome(lang,site)}threads.xml`}>RSS ↗</a>}</nav>{route.items?.length?route.items.map((thread:any)=><ThreadCard site={site} document={thread} lang={lang}/>):<div class="activity-empty">{tr('empty')}</div>}<Pagination {...route}/></> :
isTopics ? <><div class="topic-grid" data-activity-items>{topics(site,lang).map(topic=>{
const related=topicItems(site,topic),active=lastActivity(related);
const activeDate=active?new Date(active*1000).toISOString():undefined;
return <article class="topic-card" data-activity-item data-kind="topic" data-id={topic.extra.id} data-topic-id={topic.extra.id} data-active={active} data-published={timestamp(topic.date)} data-count={related.length} data-created={topic.date} data-updated={topic.updated||topic.date}><h2><a href={topic.url}>#{topic.title}</a></h2><p>{topic.description||plain(topic.html).slice(0,150)}</p><div class="topic-stats"><span>{related.length} {tr('entries')}</span><span>{activeDate?<>{tr('last_activity')} <time datetime={activeDate} title={utcDateTitle(activeDate)}>{formatDate(activeDate,lang)}</time></>:tr('no_activity')}</span></div><div class="topic-created">{tr('created')} <time datetime={topic.date} title={utcDateTitle(topic.date)}>{formatDate(topic.date,lang)}</time></div></article>;
})}</div><div class="activity-empty" data-activity-empty hidden={topics(site,lang).length>0}>{tr('empty_topics')}</div></> :
<>{isTopic&&<>{cover(document,site,false)&&<ResponsiveImage site={site} class="topic-cover" src={cover(document,site,false)} alt=""/>}<div class="thread-body topic-intro" set:html={document.html}/></>}
<nav class="activity-toolbar" aria-label={tr('filter')}>{['all','article','thread'].map(kind=><button type="button" disabled data-activity-filter={kind} class:list={{'is-active':kind==='all'}} aria-pressed={kind==='all'}>{tr(kind)}</button>)}</nav>
<div class:list={['timeline-list',{'timeline-list--connected':isTimeline}]} data-activity-items>{items.map(item=><TimelineEvent site={site} document={item} lang={lang}/>)}</div><div class="activity-empty" data-activity-empty hidden={items.length>0}>{tr('empty_timeline')}</div></>}
{!isThreads&&<nav class="activity-pagination" data-activity-pagination aria-label={tr('pages')} hidden><button type="button" data-activity-previous>← {tr('previous')}</button><span data-activity-page aria-live="polite"></span><button type="button" data-activity-next>{tr('next')} →</button></nav>}
</>}
</div>
{isThreads||isDetail ? <Sidebar site={site} lang={lang} kind="postWidget">
  <div class="card-widget"><ActivitySidebar site={site} lang={lang} current={isDetail?document.url:undefined}/></div>
</Sidebar> : isTimeline ? <aside class="activity-aside timeline-aside">
  <div class="card-widget"><ActivitySidebar site={site} lang={lang}/></div>
</aside> : <aside class="activity-aside">
  {isTopic ? <>
    <h2>{tr('topic_record')}</h2>
    <dl class="topic-dates">
      <dt>{tr('created')}</dt><dd><time datetime={document.date} title={utcDateTitle(document.date)}>{formatDate(document.date,lang)}</time></dd>
      <dt>{tr('metadata_updated')}</dt><dd><time datetime={document.updated||document.date} title={utcDateTitle(document.updated||document.date)}>{formatDate(document.updated||document.date,lang)}</time></dd>
      <dt>{tr('last_activity')}</dt><dd>{topicActivityDate?<time datetime={topicActivityDate} title={utcDateTitle(topicActivityDate)}>{formatDate(topicActivityDate,lang)}</time>:tr('no_activity')}</dd>
    </dl>
    <p>{items.length} {tr('entries')}</p>
  </> : <><h2>{title}</h2><p>{tr('topics_aside')}</p></>}
  <a href={url(isTopics?'/threads/':'/topics/')}>{isTopics?tr('threads'):`# ${tr('topics')}`} →</a>
</aside>}
</main>
