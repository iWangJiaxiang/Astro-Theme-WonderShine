---
import ResponsiveImage from '../ResponsiveImage.astro';
import ArticleTools from './ArticleTools.astro';
import ArticleTags from './ArticleTags.astro';
import {t,localizeConfig,localizeUrl} from '../../lib/locale';
import type {Site,Document} from '../../lib/types';
interface Props {site:Site;document:Document;lang:string}
const {site,document:doc,lang}=Astro.props;
const config=localizeConfig(site,lang),tr=(key:string)=>t(key,lang,site),url=(path:string)=>localizeUrl(path,lang,site);
const style=config.extra.post.copyrightsStyle,license=config.extra.post.copyrights,original=!doc.extra.reprint_url;
---
{['one','default'].includes(style)&&<div class="article-copyright-block">
  {style==='default'&&<div class="post-tools" id="post-tools"><ArticleTools site={site} document={doc} lang={lang} style={style}/><ArticleTags site={site} document={doc} lang={lang}/></div>}
  <div class="post-copyright">
    {style==='one'?<><div class="post-copyright__author_group"><a class="post-copyright__author_img" aria-label={config.author||config.title} href={url('/about/')}><ResponsiveImage site={site} src={config.extra.site.logo} alt="" class="post-copyright__author_img_back" loading="lazy"/></a><div class="post-copyright__author_name">{config.title}</div><div class="post-copyright__author_desc">{config.description}</div></div><div class="post-tools" id="post-tools"><ArticleTools site={site} document={doc} lang={lang} style={style}/></div></>:<><div class="post-copyright__author">{license.enable&&<a class="post-copyright__original" href={original?(doc.extra.copyright_url||url('/copyright/')):doc.extra.reprint_url} title={tr(original?'original_license':'reprint_license')}>{tr(original?'original':'reprint')}</a>}<a class="post-copyright-title" href="#"><span>{doc.title}</span></a></div><div class="post-copyright__type"><button class="post-copyright-copybtn" onclick="rm.copyPageUrl()" aria-label={tr('ui_copy_link')}><i class="icon-paste"></i></button></div></>}
    {license.enable&&<div class="post-copyright__notice"><span class="post-copyright-info" set:html={original?license.content:license.reprintContent}/></div>}
  </div>
  {style==='one'&&<ArticleTags site={site} document={doc} lang={lang}/>}
  <link rel="stylesheet" href={style==='one'?'/css/post-copyright-one.css':'/css/post-copyright.css'}/>
</div>}
