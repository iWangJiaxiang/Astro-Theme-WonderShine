---
import { t } from '../../lib/locale';
import type { Sponsor } from './types';
const { site, config, lang } = Astro.props;
const reward = config.extra.about_reward || {};
const sponsors: Sponsor[] = reward.sponsors || [];
const pipes = ['M1 77H234.226L307.006 24H790','M0 140H233.035L329.72 71H1028','M1 255H234.226L307.006 307H790','M0 305H233.035L329.72 375H1028'];
---
{reward.enable && <div class="author-content"><div class="author-content-item single reward" id="about-reward">
  <div class="author-content-item-tips">{t('ui_acknowledgments',lang,site)}</div><span class="author-content-item-title">{reward.title}</span><div class="author-content-item-description">{reward.content}</div>
  {reward.reward?.enable && <div class="about-reward"><div id="con"></div><button type="button" id="TA-con" onclick="window.wjx?.rewardShowConsole()"><div id="text-con"><div id="linght"></div><div id="TA">{reward.reward.name}</div></div></button><div id="tube-con">
    {['#e5e9ef','#f25d8e','#ffd52b'].map((color,index)=><div id={index===1?'mask':index===2?'orange-mask':undefined}><svg viewBox="0 0 1028 385" fill="none" xmlns="http://www.w3.org/2000/svg">{pipes.map(d=><path d={d} stroke={color} stroke-width="20"/>)}<rect y="186" width="236" height="24" fill={color}/><ellipse cx="790" cy="25.5" rx="25" ry="25.5" fill={color}/><circle r="14" transform="matrix(1 0 0 -1 790 25)" fill="white"/><ellipse cx="790" cy="307.5" rx="25" ry="25.5" fill={color}/><circle r="14" transform="matrix(1 0 0 -1 790 308)" fill="white"/></svg></div>)}
    {sponsors.length>0&&<p id="people">{t('ui_total',lang,site)}<b>{sponsors.length}</b>{t('ui_people',lang,site)}</p>}
  </div></div>}
  {sponsors.length>0&&<div class="reward-list-all">{sponsors.map(person=><div class="reward-list-item"><div>
    {person.avatar ? <div><div class="reward-list-item-avatar"><img src={person.avatar} alt={person.name || ''} loading="lazy" /></div><div style="z-index:20;float:left" class="reward-list-item-avatar-group"><div class="reward-list-item-name">{person.name}</div></div></div> : <div class="reward-list-item-name">{person.name}</div>}
    <div class="reward-list-bottom-group"><div class="reward-list-item-money" style={person.amount>=reward.reward_number?'background:var(--wjx-vip)':undefined}>¥ {person.amount}</div><time class="datatime reward-list-item-time">{person.date}</time></div>
  </div></div>)}</div>}
</div></div>}
