---
import ResponsiveImage from '../ResponsiveImage.astro';
import Comments from '../Comments.astro';
import type { EquipmentGroup } from './types';
import { localizeUrl, t } from '../../lib/locale';
const { site, config, data, lang, document: doc } = Astro.props;
const groups: EquipmentGroup[] = data.equipment?.groups || [];
const header = config.extra.equipment || {};
---
<main class="layout hide-aside" id="content-inner"><div id="page">
  <div class="author-content author-content-item essayPage single">
    {header.background_img && <ResponsiveImage site={site} pictureClass="card-background-img progressive-picture" pictureStyle="" class="progressive-content loaded" src={header.background_img} alt="" decoding="async"  sizes="100vw"/>}
    <div class="card-content"><div class="author-content-item-tips">{header.small_title}</div><span class="author-content-item-title">{header.big_title}</span><div class="content-bottom"><div class="tips">{header.detail}</div></div>
      {header.btn_url && <div class="banner-button-group"><a class="banner-button" href={localizeUrl(header.btn_url,lang,site)}><i class="icon-circle-arrow-right"></i><span class="banner-button-text">{header.btn_title}</span></a></div>}
    </div>
  </div>
  {doc?.html && <div class="post-content equipment-introduction" set:html={doc.html} />}
  <div id="equipment">{groups.map(group => <div class="equipment-item">
    <h2 class="equipment-item-title">{group.name}</h2><div class="equipment-item-description">{group.description}</div>
    <div class="equipment-item-content">{(group.items || []).map(item => <div class="equipment-item-content-item">
      <div class="equipment-item-content-item-cover"><ResponsiveImage site={site} pictureClass="equipment-item-content-item-image progressive-picture" pictureStyle="" class="progressive-content loaded" src={item.img||''} alt={item.name || ''} loading="lazy" decoding="async"  sizes="800px"/></div>
      <div class="equipment-item-content-item-info"><button type="button" class="equipment-item-content-item-name" data-copy-equipment={item.name}>{item.name}</button><div class="equipment-item-content-item-specification">{item.model}</div><div class="equipment-item-content-item-description">{item.description}</div>
        <div class="equipment-item-content-item-toolbar">
          {config.extra.comments?.enable && !doc?.extra.disable_comment && <a class="bber-reply" href="#post-comment" aria-label={t('comments',lang,site)} data-equipment-comment={`${item.name || ''} ${item.model || ''} ${item.description || ''}`}><i class="icon-chat--fill" style="font-size:22px"></i></a>}
          {item.button_url && <a class="equipment-item-content-item-link" href={item.button_url} rel="noopener noreferrer external nofollow" target="_blank">{item.button_title}</a>}
        </div>
      </div>
    </div>)}</div>
  </div>)}</div>
  <Comments site={site} lang={lang} document={doc} />
</div></main>
<script is:inline data-astro-rerun>
(() => {
  document.querySelectorAll('[data-copy-equipment]').forEach(button => button.addEventListener('click', async () => {
    const text = button.dataset.copyEquipment || '';
    if (window.rm?.rightmenuCopyText) window.rm.rightmenuCopyText(text);
    else if (navigator.clipboard) await navigator.clipboard.writeText(text);
    window.btf?.snackbarShow(document.documentElement.lang.startsWith('zh') ? '已复制装备名称' : 'Equipment name copied');
  }));
  document.querySelectorAll('[data-equipment-comment]').forEach(link => link.addEventListener('click', () => window.rm?.rightMenuCommentText(link.dataset.equipmentComment || '')));
})();
</script>
<style is:global>
  #equipment .progressive-content.loaded,.essayPage .progressive-content.loaded{opacity:1;position:static;width:100%;height:100%;object-fit:cover}
  #equipment .equipment-item-content-item-name{border:0;padding:0;background:none;text-align:left;cursor:pointer;color:var(--wjx-fontcolor);font-family:inherit;font-size:18px;font-weight:bold;line-height:1;max-width:100%;display:block}
  #equipment .equipment-item-content-item-name:hover{color:var(--wjx-main)}
</style>
