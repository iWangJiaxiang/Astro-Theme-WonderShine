---
import LocalizedEmpty from './LocalizedEmpty.astro';
import PostCards from './PostCards.astro';
import Sidebar from './Sidebar.astro';
import Pagination from './Pagination.astro';
import RecentTop from './home/RecentTop.astro';
import ContentBar from './home/ContentBar.astro';
import {threads,plain,formatDate} from '../lib/queries';
import {localizeConfig,localizeUrl,t} from '../lib/locale';
import type {Site} from '../lib/types';
import type {Route} from '../lib/routes';
interface Props {site:Site;route:Route;}
const {site,route}=Astro.props;
const {lang}=route,config=localizeConfig(site,lang);
const activity=config.extra.activity?.enable,first=(route.page||1)===1,recent=threads(site,lang).slice(0,2);
const tr=(key:string)=>t(key,lang,site,'activity'),url=(path:string)=>localizeUrl(path,lang,site);
---
<div id="home_top" class:list={{'activity-home':activity&&first}}>
  <RecentTop site={site} lang={lang} page={route.page}/>
  {activity&&first&&<section class="home-threads">
    <a class="home-threads-label" href={url('/threads/')}><span class="activity-dot"/>{tr('recent')} <span>→</span></a>
    <a class="home-threads-more" href={url('/threads/')}>{lang.startsWith('zh')?'全部动态':'View all'} →</a>
    <div class="home-threads-items">{recent.length ? recent.map(thread=>
      <a class="home-thread" href={thread.url}><time datetime={thread.updated||thread.date}>{formatDate(thread.updated||thread.date,lang)}</time><p>{plain(thread.html).slice(0,88)}</p></a>
    ) : <p class="home-threads-empty">{tr('empty')}</p>}</div>
  </section>}
</div>
<main class={`layout ${config.extra.sidebar.location}`} id="content-inner"><div class="recent-posts" id="recent-posts"><ContentBar site={site} lang={lang}/>
{route.items?.length?<PostCards site={site} items={route.items} lang={lang} compactHome={activity&&first}/>:<LocalizedEmpty site={site} lang={lang} document={route.document}/>}<Pagination {...route} site={site}/></div>{config.extra.sidebar.location!=='hide-aside'&&<Sidebar site={site} lang={lang}/>}</main>
